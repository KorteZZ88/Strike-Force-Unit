// Studio material overrides for models/cars/hummer.mdl.
// PrimeXT builds the lookup name as "<model basename>/<texture basename>".
"hummer/mirror"
{
	// A fully smooth surface uses the sharpest available cubemap mip.
	"smoothness"	"1.0"

	// Enable the native studio-model cubemap reflection path.
	"ReflectScale"	"1.0"
}
